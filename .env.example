# Resend (https://resend.com) – leave empty during local development.
# Without RESEND_API_KEY the contact form only logs submissions to the server console.
RESEND_API_KEY=
# Sender must be on a domain verified in Resend, e.g. "Agency <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
# Inbox that receives the leads
CONTACT_TO_EMAIL=
# Public URL of the site (used for sitemap, canonical, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
